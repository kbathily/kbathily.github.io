<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="ballGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f0f0f0;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Main circle (soccer ball) -->
  <circle cx="32" cy="32" r="30" fill="url(#ballGradient)" stroke="#333" stroke-width="1.5"/>
  
  <!-- Pentagon pattern (classic soccer ball) -->
  <!-- Center pentagon -->
  <polygon points="32,12 39,20 36,30 28,30 25,20" fill="#333"/>
  
  <!-- Top hexagon -->
  <polygon points="32,12 40,15 45,23 40,28 32,25 27,20" fill="none" stroke="#333" stroke-width="1"/>
  
  <!-- Bottom left hexagon -->
  <polygon points="25,20 20,25 18,35 25,38 32,32 27,25" fill="none" stroke="#333" stroke-width="1"/>
  
  <!-- Bottom right hexagon -->
  <polygon points="39,20 44,25 46,35 39,38 32,32 37,25" fill="none" stroke="#333" stroke-width="1"/>
  
  <!-- Additional pattern -->
  <line x1="32" y1="12" x2="32" y2="52" stroke="#333" stroke-width="0.5" opacity="0.5"/>
  <line x1="15" y1="32" x2="49" y2="32" stroke="#333" stroke-width="0.5" opacity="0.5"/>
</svg>